generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Rol {
  gerente_soporte
  ingeniero_soporte
  tecnico_soporte
  mecanico
  piloto
  operador
}

enum TipoProducto {
  aeronave
  gcs
  planta
  sensor_inteligencia
}

enum EstadoOT {
  borrador
  en_proceso
  pendiente_firma
  cerrada
}

enum EstadoResultado {
  bueno
  correcto_con_danos
  requiere_atencion
  no_aplica
}

// ─────────────────────────────────────────────
// USUARIOS
// ─────────────────────────────────────────────

model Usuario {
  id           String    @id @default(uuid())
  nombre       String
  email        String    @unique
  passwordHash String    @map("password_hash")
  rol          Rol
  superusuario Boolean   @default(false)
  licenciaNum  String?   @map("licencia_num")
  telefono     String?
  activo       Boolean   @default(true)
  ultimoAcceso DateTime? @map("ultimo_acceso")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relaciones — asignaciones a O/T
  ordenesComoSoporte           OrdenTrabajo[]      @relation("SoporteOT")
  ordenesComoIngenieroAuxiliar OrdenTrabajo[]      @relation("IngenieroAuxiliarOT")
  ordenesComoMecanico          OrdenTrabajo[]      @relation("MecanicoOT")
  ordenesComoGerente           OrdenTrabajo[]      @relation("GerenteOT")
  ordenesComoPiloto            OrdenTrabajo[]      @relation("PilotoOT")
  ordenesComoOperador          OrdenTrabajo[]      @relation("OperadorOT")
  // Otros
  firmasPorPaso                ResultadoPunto[]    @relation("FirmaPaso")
  fotosSubidas                 FotoInspeccion[]    @relation("FotoSubida")
  cierresSoporte               CierreOT[]          @relation("CierreSoporte")
  cierresGerente               CierreOT[]          @relation("CierreGerente")
  cierresPiloto                CierreOT[]          @relation("CierrePiloto")
  cierresOperador              CierreOT[]          @relation("CierreOperador")
  historialEstados             HistorialEstadoOT[]

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// MODELOS — unificados con discriminador de tipo
// ─────────────────────────────────────────────

model Modelo {
  id           String       @id @default(uuid())
  tipoProducto TipoProducto @map("tipo_producto")
  nombre       String
  fabricante   String?
  descripcion  String?
  createdAt    DateTime     @default(now()) @map("created_at")

  productos       Producto[]
  puntosExcluidos PuntoExcluidoPorModelo[]

  @@unique([tipoProducto, nombre])
  @@map("modelos")
}

// ─────────────────────────────────────────────
// PRODUCTO — tabla padre (Class Table Inheritance)
// ─────────────────────────────────────────────

model Producto {
  id            String       @id @default(uuid())
  tipoProducto  TipoProducto @map("tipo_producto")
  modeloId      String       @map("modelo_id")
  // matrícula / placas / serie. Único dentro del tipo.
  identificador String
  numeroSerie   String?      @map("numero_serie")
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  modelo  Modelo         @relation(fields: [modeloId], references: [id])
  ordenes OrdenTrabajo[]

  // Detalles 1:1 — solo uno estará poblado según tipoProducto
  // El nombre de cada relación coincide con el valor del enum TipoProducto
  // para permitir el acceso dinámico producto[tipoProducto] en el frontend.
  aeronave            AeronaveDetalle?
  gcs                 GcsDetalle?
  planta              PlantaDetalle?
  sensor_inteligencia SensorInteligenciaDetalle?

  @@unique([tipoProducto, identificador])
  @@map("productos")
}

// ─────────────────────────────────────────────
// DETALLES POR TIPO
// ─────────────────────────────────────────────

model AeronaveDetalle {
  productoId    String @id @map("producto_id")
  // Lecturas "actuales" — se actualizan al cerrar cada O/T
  horasTotales  Float  @default(0) @map("horas_totales")
  horasMotorDer Float  @default(0) @map("horas_motor_der")
  horasMotorIzq Float  @default(0) @map("horas_motor_izq")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("aeronave_detalle")
}

model GcsDetalle {
  productoId String  @id @map("producto_id")
  placas     String  @unique
  vin        String? @unique
  odometro   Float   @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("gcs_detalle")
}

model PlantaDetalle {
  productoId String @id @map("producto_id")
  horimetro  Float  @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("planta_detalle")
}

model SensorInteligenciaDetalle {
  productoId       String    @id @map("producto_id")
  // Se guarda directo, no se hereda del modelo
  fabricante       String?
  versionFirmware  String?   @map("version_firmware")
  fechaCalibracion DateTime? @map("fecha_calibracion")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("sensor_inteligencia_detalle")
}

// ─────────────────────────────────────────────
// FORMATOS
// ─────────────────────────────────────────────

model Formato {
  id            String       @id @default(uuid())
  tipoProducto  TipoProducto @map("tipo_producto")
  nombre        String
  version       String
  fechaVersion  DateTime     @map("fecha_version")
  objetivo      String?
  instrucciones String?
  definiciones  String?
  activo        Boolean      @default(true)
  // Secuencia ordenada de elementos del documento — ver detalle en CLAUDE.md
  secuenciaDocumento Json?   @map("secuencia_documento")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  secciones    SeccionFormato[]
  bloquesTexto BloqueTextoFormato[]
  ordenes      OrdenTrabajo[]

  @@map("formatos")
}

model BloqueTextoFormato {
  id        String   @id @default(uuid())
  formatoId String   @map("formato_id")
  titulo    String
  contenido String
  orden     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  formato Formato @relation(fields: [formatoId], references: [id], onDelete: Cascade)

  @@index([formatoId])
  @@map("bloques_texto_formato")
}

model SeccionFormato {
  id          String   @id @default(uuid())
  formatoId   String   @map("formato_id")
  nombre      String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now()) @map("created_at")

  formato Formato           @relation(fields: [formatoId], references: [id])
  puntos  PuntoInspeccion[]

  @@map("secciones_formato")
}

model PuntoInspeccion {
  id               String   @id @default(uuid())
  seccionId        String   @map("seccion_id")
  nombreComponente String   @map("nombre_componente")
  categoria        String?
  descripcion      String?
  referenciaUrl    String?  @map("referencia_url")
  esCritico        Boolean  @default(false) @map("es_critico")
  fotoRequerida    Boolean  @default(false) @map("foto_requerida")
  orden            Int
  createdAt        DateTime @default(now()) @map("created_at")

  seccion         SeccionFormato           @relation(fields: [seccionId], references: [id])
  puntosExcluidos PuntoExcluidoPorModelo[]
  resultados      ResultadoPunto[]

  @@map("puntos_inspeccion")
}

model PuntoExcluidoPorModelo {
  puntoId  String  @map("punto_id")
  modeloId String  @map("modelo_id")
  motivo   String?

  punto  PuntoInspeccion @relation(fields: [puntoId], references: [id])
  modelo Modelo          @relation(fields: [modeloId], references: [id])

  @@id([puntoId, modeloId])
  @@map("puntos_excluidos_por_modelo")
}

// ─────────────────────────────────────────────
// ÓRDENES DE TRABAJO
// ─────────────────────────────────────────────

model OrdenTrabajo {
  id         String @id @default(uuid())
  numeroOt   String @unique @map("numero_ot")
  formatoId  String @map("formato_id")
  productoId String @map("producto_id")

  // Asignaciones — todas FK a Usuario
  soporteId           String  @map("soporte_id")
  ingenieroAuxiliarId String? @map("ingeniero_auxiliar_id")
  mecanicoId          String? @map("mecanico_id")
  gerenteId           String  @map("gerente_id")
  pilotoId            String? @map("piloto_id")
  operadorId          String? @map("operador_id")

  cliente            String?
  ordenServicio      String? @map("orden_servicio")
  lugarMantenimiento String? @map("lugar_mantenimiento")

  // Lecturas del medidor — se llenan al INICIAR mantenimiento (Hito 3)
  // Solo el set correspondiente al tipo del producto se llena.
  horasTotales  Float? @map("horas_totales")
  horasMotorDer Float? @map("horas_motor_der")
  horasMotorIzq Float? @map("horas_motor_izq")
  odometro      Float?
  horimetro     Float?

  estado                 EstadoOT  @default(borrador)
  archivada              Boolean   @default(false)
  fechaRecepcion         DateTime? @map("fecha_recepcion")
  identificadorRecepcion String?   @map("identificador_recepcion")
  fechaInicio            DateTime? @map("fecha_inicio")
  fechaCierre            DateTime? @map("fecha_cierre")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  formato           Formato             @relation(fields: [formatoId], references: [id])
  producto          Producto            @relation(fields: [productoId], references: [id])
  soporte           Usuario             @relation("SoporteOT",           fields: [soporteId],           references: [id])
  ingenieroAuxiliar Usuario?            @relation("IngenieroAuxiliarOT", fields: [ingenieroAuxiliarId], references: [id])
  mecanico          Usuario?            @relation("MecanicoOT",          fields: [mecanicoId],          references: [id])
  gerente           Usuario             @relation("GerenteOT",           fields: [gerenteId],           references: [id])
  piloto            Usuario?            @relation("PilotoOT",            fields: [pilotoId],            references: [id])
  operador          Usuario?            @relation("OperadorOT",          fields: [operadorId],          references: [id])
  resultados        ResultadoPunto[]
  cierre            CierreOT?
  historial         HistorialEstadoOT[]

  @@map("ordenes_trabajo")
}

model ResultadoPunto {
  id              String          @id @default(uuid())
  ordenId         String          @map("orden_id")
  puntoId         String          @map("punto_id")
  estadoResultado EstadoResultado @map("estado_resultado")
  // Obligatoria al completar punto cuando estado = correcto_con_danos | requiere_atencion
  observacion     String?
  firmadoPor      String?         @map("firmado_por")
  fechaFirma      DateTime?       @map("fecha_firma")
  completado      Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  orden    OrdenTrabajo    @relation(fields: [ordenId], references: [id])
  punto    PuntoInspeccion @relation(fields: [puntoId], references: [id])
  firmante Usuario?        @relation("FirmaPaso", fields: [firmadoPor], references: [id])
  fotos    FotoInspeccion[]

  @@unique([ordenId, puntoId])
  @@map("resultados_puntos")
}

model FotoInspeccion {
  id            String    @id @default(uuid())
  resultadoId   String    @map("resultado_id")
  urlArchivo    String    @map("url_archivo")
  nombreArchivo String    @map("nombre_archivo")
  tamanoBytes   Int?      @map("tamano_bytes")
  subidaPor     String    @map("subida_por")
  fechaCaptura  DateTime? @map("fecha_captura")
  createdAt     DateTime  @default(now()) @map("created_at")

  resultado ResultadoPunto @relation(fields: [resultadoId], references: [id])
  usuario   Usuario        @relation("FotoSubida", fields: [subidaPor], references: [id])

  @@map("fotos_inspeccion")
}

// ─────────────────────────────────────────────
// CIERRE — soporte + gerente + (piloto solo en aeronave)
// ─────────────────────────────────────────────

model CierreOT {
  ordenId                String    @id @map("orden_id")
  seEncontroDefecto      Boolean   @map("se_encontro_defecto")
  refDocCorrectivo       String?   @map("ref_doc_correctivo")
  observacionesGenerales String?   @map("observaciones_generales")

  firmaSoporteId    String?   @map("firma_soporte_id")
  fechaFirmaSoporte DateTime? @map("fecha_firma_soporte")
  firmaGerenteId    String?   @map("firma_gerente_id")
  fechaFirmaGerente DateTime? @map("fecha_firma_gerente")
  firmaPilotoId     String?   @map("firma_piloto_id")
  fechaFirmaPiloto  DateTime? @map("fecha_firma_piloto")
  firmaOperadorId   String?   @map("firma_operador_id")
  fechaFirmaOperador DateTime? @map("fecha_firma_operador")

  firmaFisicaUrl String?  @map("firma_fisica_url")
  createdAt      DateTime @default(now()) @map("created_at")

  orden    OrdenTrabajo @relation(fields: [ordenId], references: [id])
  soporte  Usuario?     @relation("CierreSoporte",  fields: [firmaSoporteId],  references: [id])
  gerente  Usuario?     @relation("CierreGerente",  fields: [firmaGerenteId],  references: [id])
  piloto   Usuario?     @relation("CierrePiloto",   fields: [firmaPilotoId],   references: [id])
  operador Usuario?     @relation("CierreOperador", fields: [firmaOperadorId], references: [id])

  @@map("cierre_ot")
}

// ─────────────────────────────────────────────
// HISTORIAL DE ESTADOS — audit trail para reaperturas
// ─────────────────────────────────────────────

model HistorialEstadoOT {
  id             String   @id @default(uuid())
  ordenId        String   @map("orden_id")
  estadoAnterior EstadoOT @map("estado_anterior")
  estadoNuevo    EstadoOT @map("estado_nuevo")
  motivo         String?
  usuarioId      String   @map("usuario_id")
  createdAt      DateTime @default(now()) @map("created_at")

  orden   OrdenTrabajo @relation(fields: [ordenId], references: [id])
  usuario Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([ordenId])
  @@map("historial_estados_ot")
}
